{
  "name": "vida-extra-backend",
  "version": "1.0.0",
  "description": "Backend de Vida Extra: billetera virtual gamer multi-moneda",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:up": "node-pg-migrate up -m src/database/migrations --ignore-pattern \"^(\\..*|index\\.ts)$\"",
    "migrate:down": "node-pg-migrate down -m src/database/migrations --ignore-pattern \"^(\\..*|index\\.ts)$\"",
    "migrate:create": "node-pg-migrate create -j ts --migration-filename-format index -m src/database/migrations --ignore-pattern \"^(\\..*|index\\.ts)$\"",
    "seed:demo": "tsx src/database/seeds/seed-demo-users.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}

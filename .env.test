# Variables para correr la suite de tests (npm test). Sin secretos reales: las 3 APIs externas
# (tasas de cambio, AWS SES, Gemini) van mockeadas en los tests, así que estos valores son dummies.
#
# DATABASE_URL usa credenciales genéricas de Postgres local. Si tu Postgres local tiene otro
# usuario/password, no edites este archivo — creá un `.env.test.local` (ignorado por git) con tu
# propio DATABASE_URL, que pisa a este.
PORT=3001
NODE_ENV=test
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vida_extra_test
JWT_SECRET=test-jwt-secret
JWT_EXPIRES_IN=1h
EXCHANGE_RATE_API_KEY=test-exchangerate-api-key
CURRENCY_FREAKS_API_KEY=test-currencyfreaks-api-key
EXCHANGE_RATE_CACHE_TTL_MINUTES=30
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test-access-key-id
AWS_SECRET_ACCESS_KEY=test-secret-access-key
SES_FROM_EMAIL=test@vidaextra.com
GEMINI_API_KEY=test-gemini-api-key
